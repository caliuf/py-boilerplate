#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v just >/dev/null 2>&1; then
  echo "Error: 'just' is required but not found in PATH." >&2
  echo "Install the pinned toolchain with: mise install" >&2
  echo "See: docs/development/GETTING-STARTED.md" >&2
  exit 1
fi

just prepush
