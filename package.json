{
  "name": "py-boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "Python agent-first boilerplate with CLI, API, MCP and web UI",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "web:dev": "npm --workspace @py-boilerplate/web run dev",
    "web:build": "npm --workspace @py-boilerplate/web run build",
    "web:typecheck": "npm --workspace @py-boilerplate/web run typecheck",
    "web:test": "npm --workspace @py-boilerplate/web run test",
    "web:format": "biome check --write .",
    "web:format-check": "biome check .",
    "tests:typecheck": "tsc -p tests/tsconfig.json",
    "web:check": "npm run web:format-check && npm run web:lint && npm run web:typecheck && npm run tests:typecheck && npm run web:test",
    "test:e2e": "playwright test --config playwright.config.ts",
    "docs:spell": "cspell lint --no-progress",
    "web:lint": "oxlint --type-aware --config .oxlintrc.json apps/web tests/e2e playwright.config.ts",
    "web:budget": "node tools/scripts/web-budget.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.7",
    "@cspell/dict-it-it": "3.1.7",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "cspell": "10.5.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  }
}
