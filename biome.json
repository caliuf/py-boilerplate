{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/web/**",
      "tests/e2e/**",
      "playwright.config.ts",
      "tsconfig.base.json",
      "biome.json",
      "cspell.json",
      "package.json",
      "apps/web/package.json",
      "apps/web/tsconfig.json",
      "apps/web/components.json",
      "tests/tsconfig.json",
      ".oxlintrc.json",
      "tools/scripts/web-budget.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": false,
    "rules": {
      "complexity": {
        "noImportantStyles": "error"
      },
      "correctness": {
        "noUnknownProperty": "error"
      },
      "suspicious": {
        "noUnknownAtRules": "error",
        "noDuplicateProperties": "error"
      }
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": true
    }
  }
}
